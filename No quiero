<div class="modal-overlay" id="modalNuevaCorrida">
    <div class="modal-title">➕ NUEVA CORRIDA</div>
    <div class="gps-status" id="gpsStatus">📡 Detectando ubicación...</div>
    <label class="modal-label">📍 Origen</label>
    <select class="modal-select" id="selectOrigen" onchange="validarOrigenGPS()"></select>
    <label class="modal-label">📍 Destino</label>
    <select class="modal-select" id="selectDestino"></select>
    <button class="modal-btn" id="btnIniciarCorrida" onclick="iniciarNuevaCorrida()">✅ INICIAR CORRIDA</button>
    <button class="modal-cerrar" onclick="cerrarModalNuevaCorrida()">❌ CANCELAR</button>
</div>

<!-- MODAL NUEVO USUARIO -->
