    <div class="modal-title">➕ NUEVO USUARIO</div>
    <input type="text" class="login-input" id="nuNombre" placeholder="Nombre completo">
    <input type="email" class="login-input" id="nuEmail" placeholder="Correo electrónico">
    <input type="password" class="login-input" id="nuPassword" placeholder="Contraseña">
