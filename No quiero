        }
        .login-input:focus{outline:none;border-color:var(--amarillo)}
        .login-btn{
            width:100%;padding:2.5vh;background:var(--amarillo);color:var(--negro);
            border:none;border-radius:1.5vh;font-size:5vw;font-weight:700;cursor:pointer;
        }
        .login-error{color:var(--rojo);font-size:3.5vw;text-align:center;margin-top:1vh}

        .perfil-card{
            background:var(--gris);border-radius:2vh;padding:2vh 4vw;
            border:0.3vh solid var(--gris2);
