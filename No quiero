        .main-content{flex:1;overflow-y:auto;padding:2vh 4vw;display:flex;flex-direction:column;gap:2vh}

        .login-card{
            background:var(--gris);border-radius:2vh;padding:2vh 4vw;
            border:0.3vh solid var(--gris2);
