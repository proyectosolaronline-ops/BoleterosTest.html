<!-- CARGAR MATRIZ EXTERNA -->
<script src="matriz_queretaro.js"></script>

<script>
// ============================================================
// CONVERTIR MATRIZ_QUERETARO A FORMATO LOCALIDADES
// ============================================================
const localidades = Object.keys(localidadesObj).map(id => ({
    id: parseInt(id),
    nombre: localidadesObj[id],
    km: 0,
    lat: 0,
    lon: 0
}));

// Calcular km desde Central Qro para cada localidad
localidades.forEach(loc => {
    if (loc.id === 1) {
        loc.km = 0;
    } else {
        const clave = `1-${loc.id}`;
        if (MATRIZ_QUERETARO && MATRIZ_QUERETARO[clave]) {
            loc.km = MATRIZ_QUERETARO[clave].km;
        }
    }
});

// ============================================================
// DATOS DE USUARIOS
// ============================================================
const usuarios = JSON.parse(localStorage.getItem('usuarios')) || [
    {usuario_id:"USR001",nombre:"Juan Pérez Hernández",camion:"UH-1234",telefono:"4421234567",email:"juan@email.com",password:"123456",rol:"operador",estado:"Activo"},
    {usuario_id:"USR002",nombre:"María López García",camion:"UH-5678",telefono:"4427654321",email:"maria@email.com",password:"123456",rol:"operador",estado:"Activo"},
    {usuario_id:"USR003",nombre:"Admin Sistema",camion:"—",telefono:"4420000000",email:"admin@email.com",password:"admin123",rol:"admin",estado:"Activo"}
];

let sesionActiva = null;
let miUbicacion = null;

// ============================================================
// GPS
// ============================================================
function distKm(lat1,lon1,lat2,lon2){
    const R=6371,dL=(lat2-lat1)*Math.PI/180,dO=(lon2-lon1)*Math.PI/180;
    return R*2*Math.atan2(Math.sqrt(Math.sin(dL/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dO/2)**2),Math.sqrt(1-Math.sin(dL/2)**2-Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dO/2)**2));
}

function detectarUbicacion() {
    if(!navigator.geolocation) {
        document.getElementById('gpsStatus').textContent = '⚠ GPS no disponible';
        document.getElementById('gpsStatus').className = 'gps-status error';
        return;
    }
    document.getElementById('gpsStatus').textContent = '📡 Detectando ubicación...';
    document.getElementById('gpsStatus').className = 'gps-status';
    
    navigator.geolocation.getCurrentPosition(function(pos) {
        const lat = pos.coords.latitude;
        const lon = pos.coords.longitude;
        miUbicacion = {lat, lon, localidad: null};
        
        let best=null, min=Infinity;
        localidades.forEach(l => {
            const d = distKm(lat, lon, l.lat, l.lon);
            if(d<min){min=d;best=l;}
        });
        
        if(best && min <= 2) {
            miUbicacion.localidad = best;
            document.getElementById('gpsStatus').textContent = `📍 Te encuentras en: ${best.nombre}`;
            document.getElementById('gpsStatus').className = 'gps-status';
        } else if(best) {
            miUbicacion.localidad = best;
            document.getElementById('gpsStatus').textContent = `📍 Cerca de: ${best.nombre} (${Math.round(min)} km)`;
            document.getElementById('gpsStatus').className = 'gps-status';
        } else {
            document.getElementById('gpsStatus').textContent = '⚠ No se pudo determinar tu ubicación';
            document.getElementById('gpsStatus').className = 'gps-status error';
        }
        validarOrigenGPS();
    }, function() {
        document.getElementById('gpsStatus').textContent = '⚠ Activa el GPS para continuar';
        document.getElementById('gpsStatus').className = 'gps-status error';
        miUbicacion = null;
    }, {enableHighAccuracy:true,timeout:10000});
}

function validarOrigenGPS() {
    const origenId = parseInt(document.getElementById('selectOrigen').value);
    const origen = localidades.find(l=>l.id===origenId);
    const btn = document.getElementById('btnIniciarCorrida');
    
    if(!origen || !miUbicacion || !miUbicacion.localidad) {
        btn.disabled = true;
        btn.style.opacity = '0.5';
        return;
    }
    
    const distancia = distKm(miUbicacion.lat, miUbicacion.lon, origen.lat, origen.lon);
    
    if(distancia <= 2) {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.textContent = '✅ INICIAR CORRIDA';
        btn.style.background = 'var(--verde)';
    } else {
        btn.disabled = true;
        btn.style.opacity = '0.5';
        btn.textContent = `⚠ Debes estar en ${origen.nombre}`;
        btn.style.background = 'var(--rojo)';
    }
}

// ============================================================
// LOGIN
// ============================================================
function iniciarSesion() {
    const email = document.getElementById('loginEmail').value.trim();
    const password = document.getElementById('loginPassword').value.trim();
    const errorEl = document.getElementById('loginError');
    
    if(!email || !password) {
        errorEl.textContent = 'Ingresa correo y contraseña';
        return;
    }
    
    const usuario = usuarios.find(u => u.email === email && u.estado === 'Activo');
    
    if(!usuario) {
        errorEl.textContent = 'Usuario no encontrado o inactivo';
        return;
    }
    
    if(usuario.password !== password) {
        errorEl.textContent = 'Contraseña incorrecta';
        return;
    }
    
    errorEl.textContent = '';
    sesionActiva = usuario;
    localStorage.setItem('sesionActiva', JSON.stringify(usuario));
    
    document.getElementById('loginCard').style.display = 'none';
    document.getElementById('btnSalir').style.display = 'block';
    document.getElementById('headerRol').style.display = 'block';
    document.getElementById('headerRol').textContent = usuario.rol === 'admin' ? '⚙️ Admin' : '🚌 Operador';
    
    if(usuario.rol === 'admin') {
        document.getElementById('panelAdmin').style.display = 'block';
        renderAdminPanel();
    } else {
        document.getElementById('panelOperador').style.display = 'block';
        renderPanelOperador();
    }
}

function cerrarSesion() {
    sesionActiva = null;
    miUbicacion = null;
    localStorage.removeItem('sesionActiva');
    document.getElementById('loginCard').style.display = 'block';
    document.getElementById('panelOperador').style.display = 'none';
    document.getElementById('panelAdmin').style.display = 'none';
    document.getElementById('btnSalir').style.display = 'none';
    document.getElementById('headerRol').style.display = 'none';
    document.getElementById('loginEmail').value = '';
    document.getElementById('loginPassword').value = '';
    document.getElementById('loginError').textContent = '';
}

// ============================================================
// PANEL OPERADOR
// ============================================================
function renderPanelOperador() {
    if(!sesionActiva) return;
    document.getElementById('perfilNombre').textContent = `👤 ${sesionActiva.nombre}`;
    document.getElementById('perfilCamion').textContent = `🚛 Camión: ${sesionActiva.camion}`;
    document.getElementById('perfilEmail').textContent = `📧 ${sesionActiva.email}`;
    
    const corridas = JSON.parse(localStorage.getItem('corridas')) || [];
    const misCorridas = corridas.filter(c => c.usuario_id === sesionActiva.usuario_id).slice(-5).reverse();
    const lista = document.getElementById('corridasLista');
    if(misCorridas.length === 0) {
        lista.innerHTML = '<div class="sin-datos">Sin corridas anteriores</div>';
        return;
    }
    lista.innerHTML = '';
    misCorridas.forEach(c => {
        const item = document.createElement('div');
        item.className = 'corrida-item';
        item.innerHTML = `
            <div class="corrida-info">
                <div class="corrida-ruta">📍 ${c.origen} → ${c.destino}</div>
                <div class="corrida-fecha">📅 ${c.fecha} · 🕐 ${c.hora_corte || ''}</div>
            </div>
            <div class="corrida-total">$${c.total}</div>
        `;
        lista.appendChild(item);
    });
}

// ============================================================
// PANEL ADMIN
// ============================================================
function renderAdminPanel() {
    const listaU = document.getElementById('usuariosLista');
    listaU.innerHTML = '';
    usuarios.forEach(u => {
        const item = document.createElement('div');
        item.className = 'admin-item';
        item.innerHTML = `
            <div class="admin-info">
                <div class="admin-nombre">👤 ${u.nombre} <span style="color:${u.rol==='admin'?'var(--morado)':'var(--verde)'};font-size:2.5vw;">(${u.rol})</span></div>
                <div class="admin-detalle">📧 ${u.email} · 🚛 ${u.camion} · ${u.estado}</div>
            </div>
        `;
        listaU.appendChild(item);
    });
    
    const corridas = JSON.parse(localStorage.getItem('corridas')) || [];
    const listaC = document.getElementById('reporteCorridas');
    if(corridas.length === 0) {
        listaC.innerHTML = '<div class="sin-datos">Sin corridas registradas</div>';
        return;
    }
    listaC.innerHTML = '';
    const totalGeneral = corridas.reduce((s,c)=>s+c.total,0);
    listaC.innerHTML += `<div class="admin-item"><div class="admin-info"><div class="admin-nombre">💰 Total general</div></div><div class="corrida-total">$${totalGeneral}</div></div>`;
    corridas.slice(-10).reverse().forEach(c => {
        const op = usuarios.find(u=>u.usuario_id===c.usuario_id);
        const item = document.createElement('div');
        item.className = 'corrida-item';
        item.innerHTML = `
            <div class="corrida-info">
                <div class="corrida-ruta">📍 ${c.origen} → ${c.destino}</div>
                <div class="corrida-fecha">👤 ${op?op.nombre:'Desconocido'} · 📅 ${c.fecha}</div>
            </div>
            <div class="corrida-total">$${c.total}</div>
        `;
        listaC.appendChild(item);
    });
}

// ============================================================
// NUEVA CORRIDA (PERMITE CUALQUIER DIRECCIÓN)
// ============================================================
function abrirModalNuevaCorrida() {
    if(!sesionActiva){alert('⚠ Inicia sesión primero');return}
    const selOrigen = document.getElementById('selectOrigen');
    const selDestino = document.getElementById('selectDestino');
    selOrigen.innerHTML = '';
    selDestino.innerHTML = '';
    localidades.forEach(l => {
        selOrigen.innerHTML += `<option value="${l.id}">${l.nombre} (km ${l.km})</option>`;
        selDestino.innerHTML += `<option value="${l.id}">${l.nombre} (km ${l.km})</option>`;
    });
    document.getElementById('btnIniciarCorrida').disabled = true;
    document.getElementById('btnIniciarCorrida').style.opacity = '0.5';
    document.getElementById('btnIniciarCorrida').textContent = '✅ INICIAR CORRIDA';
    document.getElementById('btnIniciarCorrida').style.background = 'var(--verde)';
    document.getElementById('modalNuevaCorrida').classList.add('active');
    detectarUbicacion();
}

function cerrarModalNuevaCorrida() {
    document.getElementById('modalNuevaCorrida').classList.remove('active');
}

function iniciarNuevaCorrida() {
    const origenId = parseInt(document.getElementById('selectOrigen').value);
    const destinoId = parseInt(document.getElementById('selectDestino').value);
    const origen = localidades.find(l=>l.id==origenId);
    const destino = localidades.find(l=>l.id==destinoId);
    
    if(origenId === destinoId){alert('⚠ Origen y destino no pueden ser iguales');return}
    // Ya NO se valida dirección — se permiten corridas en ambos sentidos
    
    if(!miUbicacion || !miUbicacion.localidad) {
        alert('⚠ No se pudo determinar tu ubicación. Activa el GPS e inténtalo de nuevo.');
        return;
    }
    
    const distancia = distKm(miUbicacion.lat, miUbicacion.lon, origen.lat, origen.lon);
    
    if(distancia > 2) {
        alert(`⚠ NO PUEDES INICIAR ESTA CORRIDA\n\nTe encuentras en: ${miUbicacion.localidad.nombre}\nLa corrida debe iniciar en: ${origen.nombre}\n\nDebes estar en el origen para poder iniciar.`);
        return;
    }
    
    sesionActiva.origen = origen.nombre;
    sesionActiva.destino = destino.nombre;
    sesionActiva.hora_inicio = new Date().toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'});
    localStorage.setItem('sesionActiva', JSON.stringify(sesionActiva));
    
    window.location.href = 'boletero.html';
}

// ============================================================
// ADMIN: AGREGAR USUARIO
// ============================================================
function abrirModalNuevoUsuario() {
    document.getElementById('modalNuevoUsuario').classList.add('active');
}

function cerrarModalNuevoUsuario() {
    document.getElementById('modalNuevoUsuario').classList.remove('active');
}

function agregarUsuario() {
    const nombre = document.getElementById('nuNombre').value.trim();
    const email = document.getElementById('nuEmail').value.trim();
    const password = document.getElementById('nuPassword').value.trim();
    const rol = document.getElementById('nuRol').value;
    const camion = document.getElementById('nuCamion').value.trim();
    const telefono = document.getElementById('nuTelefono').value.trim();
    
    if(!nombre || !email || !password){alert('⚠ Completa los campos obligatorios');return}
    if(usuarios.find(u=>u.email===email)){alert('⚠ El correo ya está registrado');return}
    
    const nuevo = {
        usuario_id: 'USR' + (usuarios.length + 1).toString().padStart(3,'0'),
        nombre, email, password, rol, camion, telefono,
        estado: 'Activo'
    };
    
    usuarios.push(nuevo);
    localStorage.setItem('usuarios', JSON.stringify(usuarios));
    alert('✅ Usuario agregado correctamente');
    cerrarModalNuevoUsuario();
    renderAdminPanel();
    
    document.getElementById('nuNombre').value = '';
    document.getElementById('nuEmail').value = '';
    document.getElementById('nuPassword').value = '';
    document.getElementById('nuCamion').value = '';
    document.getElementById('nuTelefono').value = '';
}

// ============================================================
// INICIO
// ============================================================
const sesionGuardada = JSON.parse(localStorage.getItem('sesionActiva'));
if(sesionGuardada) {
    sesionActiva = sesionGuardada;
    document.getElementById('loginCard').style.display = 'none';
    document.getElementById('btnSalir').style.display = 'block';
    document.getElementById('headerRol').style.display = 'block';
    document.getElementById('headerRol').textContent = sesionGuardada.rol === 'admin' ? '⚙️ Admin' : '🚌 Operador';
    if(sesionGuardada.rol === 'admin') {
        document.getElementById('panelAdmin').style.display = 'block';
        renderAdminPanel();
    } else {
        document.getElementById('panelOperador').style.display = 'block';
        renderPanelOperador();
    }
}
</script>
</body>
</html>
