        .corrida-info{display:flex;flex-direction:column}
        .corrida-ruta{font-size:3.5vw;font-weight:600}
        .corrida-fecha{font-size:2.5vw;color:var(--gris-texto)}
        .corrida-total{font-size:4vw;font-weight:700;color:var(--verde)}

        .btn-nueva-corrida{
            padding:3vh;background:var(--verde);color:var(--blanco);border:none;border-radius:2vh;
            font-size:6vw;font-weight:800;cursor:pointer;text-align:center;
            box-shadow:0 1vh 3vh rgba(34,197,94,0.3);
        }
        .btn-nueva-corrida:disabled{background:var(--gris2);color:#555;box-shadow:none}
        .btn-admin{
            padding:2.5vh;background:var(--morado);color:var(--blanco);border:none;border-radius:2vh;
            font-size:5vw;font-weight:700;cursor:pointer;text-align:center;
        }
        .btn-salir{
            padding:2vh;background:transparent;color:var(--rojo);
            border:0.2vh solid var(--rojo);border-radius:1.5vh;
            font-size:4vw;cursor:pointer;text-align:center;
        }

        .modal-overlay{
            position:fixed;top:0;left:0;width:100vw;height:100vh;
            background:rgba(10,10,10,0.98);z-index:3000;display:none;flex-direction:column;padding:3vh 4vw;
        }
        .modal-overlay.active{display:flex}
        .modal-title{font-size:7vw;font-weight:700;color:var(--amarillo-texto);text-align:center;margin-bottom:3vh}
        .modal-label{font-size:4vw;color:var(--gris-texto);margin-bottom:1vh}
        .modal-select{
            width:100%;padding:2vh 3vw;background:var(--negro);color:var(--blanco);
            border:0.2vh solid var(--gris2);border-radius:1vh;font-size:5vw;margin-bottom:2vh;
        }
        .modal-select:focus{outline:none;border-color:var(--amarillo)}
        .modal-btn{
            width:100%;padding:3vh;background:var(--verde);color:var(--blanco);
            border:none;border-radius:2vh;font-size:5.5vw;font-weight:700;cursor:pointer;margin-top:2vh;
        }
        .modal-cerrar{
            width:100%;padding:2.5vh;background:transparent;color:var(--rojo);
            border:0.2vh solid var(--rojo);border-radius:1.5vh;font-size:4.5vw;font-weight:700;cursor:pointer;margin-top:1.5vh;
        }

        .admin-section{
            background:var(--gris);border-radius:2vh;padding:2vh 4vw;
            border:0.3vh solid var(--morado);
        }
        .admin-titulo{font-size:4vw;font-weight:700;color:var(--morado);margin-bottom:1.5vh}
        .admin-item{
            background:var(--negro);padding:1.5vh 3vw;border-radius:1vh;
            display:flex;justify-content:space-between;align-items:center;
            margin-bottom:1vh;
        }
        .admin-info{display:flex;flex-direction:column}
        .admin-nombre{font-size:3.5vw;font-weight:600}
        .admin-detalle{font-size:2.5vw;color:var(--gris-texto)}

        .gps-status{
            background:var(--negro);padding:1.5vh 3vw;border-radius:1vh;
            font-size:3.5vw;color:var(--verde);text-align:center;margin-bottom:1.5vh;
        }
        .gps-status.error{color:var(--rojo)}

        .sin-datos{text-align:center;color:#555;padding:2vh;font-size:3.5vw}
    </style>
</head>
<body>

